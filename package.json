    "review": "node scripts/review.ts",
    "commit:lint": "node scripts/lint-commit-message.ts",
    "pr:lint": "node scripts/lint-pr-body.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^7.0.2"
  },
